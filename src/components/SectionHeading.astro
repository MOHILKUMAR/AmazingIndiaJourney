---
// Reference-style heading: bold navy words + an italic orange accent word + a short orange bar underneath.
// <SectionHeading title="Explore our popular" accent="tours" />
interface Props { eyebrow?: string; title: string; accent?: string; accentFirst?: boolean; text?: string; center?: boolean; light?: boolean; as?: 'h1' | 'h2' }
const { eyebrow, title, accent, accentFirst = false, text, center = false, light = false, as: Tag = 'h2' } = Astro.props;
---
<div class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class:list={['mt-2 text-[1.75rem] leading-tight sm:text-4xl', light ? '!text-white' : 'text-dark-900']}>
    {accent && accentFirst && <><span class:list={['accent-word', light && '!text-accent-100']}>{accent}</span>{' '}</>}
    {title}
    {accent && !accentFirst && <>{' '}<span class:list={['accent-word', light && '!text-accent-100']}>{accent}</span></>}
  </Tag>
  <span class:list={['mt-4 block h-1 w-16 bg-accent-400', center && 'mx-auto']} aria-hidden="true"></span>
  {text && <p class:list={['mt-4 text-base leading-relaxed', light ? 'text-white/85' : 'text-muted']}>{text}</p>}
</div>
