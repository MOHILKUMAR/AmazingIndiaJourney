---
// "Talk to us" call-to-action (reference layout: light grey band, heading with accent word, green button)
interface Props { title?: string; accent?: string; text?: string }
const {
  title = 'Talk to us about your',
  accent = Astro.props.title ? undefined : 'India tour',
  text = 'Tell us what you want to experience and we’ll create your perfect private India journey. Your dream trip starts with a free quote.',
} = Astro.props;
---
<section class="mt-20 border-y border-line bg-sand">
  <div class="container-x flex flex-col items-start justify-between gap-6 py-14 lg:flex-row lg:items-center">
    <div class="max-w-2xl">
      <h2 class="text-[1.75rem] leading-tight sm:text-4xl">{title}{accent && <> <span class="accent-word">{accent}</span></>}</h2>
      <p class="mt-3 text-muted">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/contact/" class="btn-primary">Enquire Now</a>
      <a href="/tours/" class="btn-outline">Browse tours</a>
    </div>
  </div>
</section>
