---
import ImageBox from './ImageBox.astro';
interface Props { title: string; subtitle?: string; eyebrow?: string; image?: string; crumbs?: { label: string; href?: string }[] }
const { title, subtitle, eyebrow, image, crumbs = [] } = Astro.props;
---
<section class="relative isolate overflow-hidden">
  <ImageBox src={image} alt="" seed={title} class="absolute inset-0 -z-10 h-full w-full" eager />
  <div class="absolute inset-0 -z-10 bg-dark-950/70"></div>
  <div class="container-x py-20 sm:py-28 text-cream">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-white/80">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-white">Home</a></li>
          {crumbs.map((c) => (<><li aria-hidden="true">/</li><li>{c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span aria-current="page">{c.label}</span>}</li></>))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow !text-accent-400">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight !text-white sm:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg text-white/90">{subtitle}</p>}
    <slot />
  </div>
</section>
