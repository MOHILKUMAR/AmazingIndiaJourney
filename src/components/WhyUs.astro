---
// Reference layout: tall photo on the left, heading + 3x2 grid of reasons with tinted icon tiles, green button
import SectionHeading from './SectionHeading.astro';
const i = {
  map: 'M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Zm0 0v14m6-12v14',
  eye: 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  car: 'M5 17h14M6 17v2M18 17v2M3 13l2-6h14l2 6v4H3v-4Z',
  shield: 'M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Zm-3 9 2 2 4-4',
  chat: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z',
  clock: 'M12 7v5l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
};
const items = [
  { title: '100% tailor-made itineraries', text: 'Every trip is customised to your pace, preferences and travel style, whether you travel solo, as a couple or as a family.', icon: i.map, tint: 'bg-primary-100 text-primary-600' },
  { title: 'Authentic local insights', text: 'Insider access, handpicked heritage stays and guides who bring history to life.', icon: i.eye, tint: 'bg-accent-100 text-accent-600' },
  { title: 'Seamless private transport', text: 'Air-conditioned private vehicles and dedicated drivers across Delhi, Agra, Jaipur and Rajasthan.', icon: i.car, tint: 'bg-[#fdeaf3] text-[#b0306e]' },
  { title: 'Secure, flexible booking', text: 'Reserve now and pay later with just a 15% advance deposit. Pay the rest during the tour.', icon: i.shield, tint: 'bg-[#fff5d9] text-[#8a6200]' },
  { title: 'Multilingual guides', text: 'Live guides in English, Spanish, German, French, Russian and Japanese.', icon: i.chat, tint: 'bg-primary-100 text-primary-600' },
  { title: '24/7 assistance', text: 'From planning to final departure, our team is always a call away.', icon: i.clock, tint: 'bg-accent-100 text-accent-600' },
];
---
<section class="section-alt">
  <div class="grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <img src="/images/amber-fort.webp" alt="Amber Fort, Jaipur" width="1600" height="1193" loading="lazy" decoding="async" class="h-64 w-full object-cover sm:h-96 lg:h-full" />
    <div class="px-4 py-16 sm:px-10 lg:px-14">
      <SectionHeading title="Here’s why you should" accent="travel with us!" text="For over 18 years we have guided more than 50,000 travellers through India's cultural heartlands." />
      <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
        {items.map((it) => (
          <div>
            <span class:list={['flex h-11 w-11 items-center justify-center rounded-md', it.tint]} aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={it.icon} /></svg>
            </span>
            <h3 class="mt-3 text-[15px] leading-snug">{it.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{it.text}</p>
          </div>
        ))}
      </div>
      <a href="/about/" class="btn-primary mt-10">Explore more</a>
    </div>
  </div>
</section>
