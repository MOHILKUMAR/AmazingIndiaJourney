---
import SectionHeading from './SectionHeading.astro';
import { site } from '../site.config';
interface Props { heading?: boolean }
const { heading = true } = Astro.props;
const items = [
  { title: 'Ministry of Tourism', text: 'Approved by Ministry of Tourism, India' },
  { title: 'IATO Approved', text: 'Indian Association of Tour Operators' },
  { title: 'TripAdvisor', text: 'Certificate of Excellence 2015–2020, 2022, 2023' },
  { title: 'Top Rated on Viator', text: 'Exceptional experiences, top ratings' },
  { title: `${site.rating.score}/5 on Google`, text: `From ${site.rating.count} people who travelled with us` },
  { title: `ESTD ${site.established}`, text: `${site.stats.years} years of experience` },
];
---
<section class="py-16">
  <div class="container-x">
    {heading && <SectionHeading title="Credentials &" accent="recognition" />}
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((i) => (
        <div class="card border-t-4 border-accent-400 p-5">
          <h3 class="font-sans text-base font-semibold text-dark-900">{i.title}</h3>
          <p class="mt-1 text-sm text-muted">{i.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
