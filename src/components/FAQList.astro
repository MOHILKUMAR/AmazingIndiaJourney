---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="divide-y divide-line border border-line bg-white">
  {items.map((f) => (
    <details class="group px-6 py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-dark-900">
        {f.q}
        <span class="text-primary-500 text-2xl transition group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-muted">{f.a}</p>
    </details>
  ))}
</div>
