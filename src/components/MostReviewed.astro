---
import { getCollection } from 'astro:content';
import { formatCount } from '../scripts/format';
const tours = (await getCollection('tours')).filter((t) => t.data.reviewCount).sort((a, b) => b.data.reviewCount! - a.data.reviewCount!).slice(0, 8);
const max = tours[0]?.data.reviewCount ?? 1;
---
<div class="card p-6">
  <h3 class="text-xl text-dark-900">Most-reviewed tours</h3>
  <ul class="mt-5 space-y-3">
    {tours.map((t) => (
      <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto]">
        <a href={`/packages/${t.id}/`} class="truncate text-sm text-ink hover:text-primary-500">{t.data.title}</a>
        <span class="order-3 col-span-2 h-2 overflow-hidden rounded-lg bg-sand sm:order-none sm:col-span-1">
          <span class="block h-full rounded-lg bg-primary-500" style={`width:${(t.data.reviewCount! / max) * 100}%`}></span>
        </span>
        <span class="text-sm font-semibold text-dark-900">{formatCount(t.data.reviewCount!)}</span>
      </li>
    ))}
  </ul>
</div>
