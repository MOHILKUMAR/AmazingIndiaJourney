---
interface Props { rating?: number }
const { rating = 5 } = Astro.props;
---
<span class="inline-flex text-star" aria-label={`${rating} out of 5 stars`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg width="16" height="16" viewBox="0 0 20 20" fill={i < rating ? 'currentColor' : 'none'} stroke="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"/></svg>
  ))}
</span>
