---
// White footer with grey text and a light grey bottom bar (reference layout)
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';
import { site, categories, whatsappLink } from '../site.config';
const year = new Date().getFullYear();
const places = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
const linkCls = 'text-dark-600 hover:text-primary-500';
const headCls = 'font-sans text-base font-bold text-dark-900';
---
<footer class="mt-24 border-t-4 border-accent-400 bg-white">
  <div class="container-x grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-5">
    <div>
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-dark-600">{site.name}, a unit of {site.parent}. {site.tagline}.</p>
      <p class="mt-3 text-lg"><span class="accent-word">“{site.motto}”</span></p>
    </div>
    <div>
      <h3 class={headCls}>Tours</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {categories.map((c) => <li><a href={`/${c.slug}/`} class={linkCls}>{c.label}</a></li>)}
        <li><a href="/tours/" class={linkCls}>All tours</a></li>
      </ul>
    </div>
    <div>
      <h3 class={headCls}>Destinations</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {places.map((p) => <li><a href={`/city/${p.id}/`} class={linkCls}>{p.data.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class={headCls}>Company</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/about/" class={linkCls}>About us</a></li>
        <li><a href="/reviews/" class={linkCls}>Reviews</a></li>
        <li><a href="/gallery/" class={linkCls}>Gallery</a></li>
        <li><a href="/blog/" class={linkCls}>Travel blog</a></li>
        <li><a href="/faq/" class={linkCls}>FAQ</a></li>
        <li><a href="/terms/" class={linkCls}>Terms & conditions</a></li>
        <li><a href="/privacy/" class={linkCls}>Privacy policy</a></li>
        <li><a href="/disclaimer/" class={linkCls}>Disclaimer</a></li>
      </ul>
    </div>
    <div>
      <h3 class={headCls}>Get in touch</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={whatsappLink()} target="_blank" rel="noopener" class={linkCls}>Call / WhatsApp: {site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class={`break-all ${linkCls}`}>{site.email}</a></li>
        <li class="text-dark-600">{site.address}</li>
      </ul>
      <a href="/contact/" class="btn-primary mt-6">Enquire Now</a>
    </div>
  </div>
  <div class="bg-sand">
    <div class="container-x flex flex-wrap justify-between gap-2 py-5 text-xs text-dark-600">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>Prices in US$ per person, subject to availability and change.</span>
    </div>
  </div>
</footer>
