---
// Home page. Order set by the client's layout instructions:
// 1 hero → 2 same day tours (4 cards) → 3 reviews → 4 golden triangle tours (4 cards) → 5 enquiry form beside photo
// then the remaining sections: promise blocks → intro → tour styles → why us → FAQ → destinations → who we are
// Sections alternate white / light grey.
import Base from '../layouts/Base.astro';
import TourCard from '../components/TourCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PromiseCards from '../components/PromiseCards.astro';
import ReviewSlider from '../components/ReviewSlider.astro';
import WhyUs from '../components/WhyUs.astro';
import FAQList from '../components/FAQList.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { getCollection } from 'astro:content';
import { site, categories, whatsappLink } from '../site.config';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const byCat = (id: string) => tours.filter((t) => t.data.category === id).slice(0, 4);
const tourRows = [
  { id: 'same-day', slug: 'same-day-tours', title: 'Same day', accent: 'tours', text: 'See the Taj Mahal, Delhi or Jaipur in a single day, with pickup from your Delhi hotel.', tours: byCat('same-day'), alt: false },
  { id: 'golden-triangle', slug: 'golden-triangle-tours', title: 'Golden Triangle', accent: 'tours', text: 'Delhi, Agra and Jaipur in 3 to 6 days with 4 and 5 star hotels.', tours: byCat('golden-triangle'), alt: false },
];
const places = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
const styles = categories.map((c) => ({ ...c, count: tours.filter((t) => t.data.category === c.id).length }));
const faqs = (await getCollection('faqs')).slice(0, 6).map((f) => f.data);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TravelAgency',
      name: site.name,
      description: site.description,
      email: site.email,
      telephone: site.phone,
      foundingDate: String(site.established),
      address: { '@type': 'PostalAddress', streetAddress: '123 Sample Road', addressLocality: 'Agra', postalCode: '000000', addressCountry: 'IN' /* TODO: real address */ },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.score, bestRating: 5, reviewCount: 5000 },
      url: Astro.site?.toString(),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base title={`${site.name} | Taj Mahal, Golden Triangle & Rajasthan Tours`} description={site.description} image="/images/hero.webp" jsonLd={jsonLd}>
  <!-- 1. Hero: full-width Taj Mahal photo, centred title, 2 buttons -->
  <section class="relative isolate flex min-h-[78vh] items-center overflow-hidden">
    <img src="/images/hero.webp" alt="Taj Mahal, Agra" width="1344" height="896" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-dark-950/55"></div>
    <div class="container-x py-24 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.35em] text-white/90">This is</p>
      <h1 class="mt-2 text-6xl font-extrabold uppercase tracking-[0.12em] !text-white sm:text-8xl">India</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-white/90">Private Taj Mahal, Golden Triangle and Rajasthan tours. {site.tagline}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#enquire" class="btn-primary">Book Now</a>
        <a href="/tours/" class="btn-ghost">Explore tours</a>
      </div>
    </div>
  </section>

  <!-- 2. Same Day Tours · 3. Reviews · 4. Golden Triangle Tours -->
  {tourRows.map((row, i) => (
    <>
      <section id={row.id} class="scroll-mt-32 py-20">
        <div class="container-x">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading title={row.title} accent={row.accent} text={row.text} />
            <a href={`/${row.slug}/`} class="btn-outline">View all</a>
          </div>
          <!-- slider on mobile and tablet, 4 cards in a row on desktop -->
          <div class="-mx-4 mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-6 pt-2 [scrollbar-width:none] lg:mx-0 lg:grid lg:grid-cols-4 lg:overflow-visible lg:px-0">
            {row.tours.map((t) => <TourCard tour={t} class="w-[85%] shrink-0 snap-start sm:w-[46%] lg:w-auto" />)}
          </div>
          <p class="mt-2 text-center text-xs text-muted lg:hidden" aria-hidden="true">Swipe to see more →</p>
        </div>
      </section>
      {i === 0 && <div class="section-alt"><ReviewSlider /></div>}
    </>
  ))}

  <!-- 5. Enquiry form beside photo -->
  <section id="enquire" class="section-alt scroll-mt-32">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-72 sm:min-h-96">
        <img src="/images/about.webp" alt="Traveller at the Taj Mahal framed by an arch" width="564" height="563" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-x-0 bottom-0 bg-dark-900/85 px-6 py-5 text-white sm:px-10">
          <p class="text-lg font-bold">Reserve now, pay later</p>
          <p class="mt-1 text-sm text-white/90">15% deposit to confirm · Free cancellation up to 24 h on same-day tours</p>
        </div>
      </div>
      <div class="px-4 py-16 sm:px-10 lg:px-14">
        <SectionHeading title="Plan your" accent="India trip" text="Tell us your dates and pickup point. We reply within 24 hours with a free, tailor-made quote." />
        <div class="mt-8"><EnquiryForm /></div>
        <p class="mt-6 text-sm text-muted">Prefer WhatsApp? <a href={whatsappLink()} target="_blank" rel="noopener" class="font-semibold text-primary-500 underline hover:text-primary-600">Chat with us on {site.phone}</a></p>
      </div>
    </div>
  </section>

  <!-- Remaining sections -->
  <PromiseCards />

  <section class="section-alt py-14">
    <div class="container-x flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div class="max-w-3xl">
        <h2 class="text-[1.75rem] leading-tight sm:text-4xl">Agra’s trusted private tour specialist</h2>
        <p class="mt-1 text-[1.75rem] font-bold leading-tight text-primary-500 sm:text-4xl">since {site.established}</p>
        <p class="mt-4 text-muted">{site.name} is a unit of {site.parent}. We plan private same-day and multi-day tours across Delhi, Agra, Jaipur and Rajasthan, approved by the Ministry of Tourism, India. More than 50,000 travellers have toured with us.</p>
      </div>
      <a href="#enquire" class="btn-primary shrink-0 !px-10 !py-4">Book Now</a>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <SectionHeading center title="Explore our" accent="private tours" text="Every tour is private: just your group, your own car and driver, and a local guide." />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {styles.map((c) => (
          <a href={`/${c.slug}/`} class="card group block overflow-hidden">
            <span class="block aspect-[4/3] overflow-hidden">
              <img src={c.image} alt="" width="564" height="423" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            </span>
            <span class="block p-5">
              <span class="block text-lg font-bold text-dark-900 group-hover:text-primary-500">{c.label}</span>
              <span class="mt-1 block text-sm text-muted">{c.blurb}</span>
              <span class="mt-3 block text-sm font-bold text-primary-500">{c.count} tours →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <WhyUs />

  <section class="py-20">
    <div class="container-x max-w-4xl">
      <SectionHeading center title="Frequently asked" accent="questions" text="Can’t find your answer? Message us on WhatsApp. We reply fast." />
      <div class="mt-10"><FAQList items={faqs} /></div>
      <div class="mt-8 text-center"><a href="/faq/" class="btn-outline">See all FAQs</a></div>
    </div>
  </section>

  <section class="section-alt py-20">
    <div class="container-x">
      <SectionHeading center title="Explore the wonderful" accent="places we visit" />
      <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-3">
        {places.map((p) => (
          <a href={`/city/${p.id}/`} class="group relative block aspect-[4/3] overflow-hidden">
            <img src={p.data.image} alt="" width="564" height="563" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            <span class="absolute inset-x-0 bottom-0 bg-dark-950/60 px-4 py-3 text-base font-bold text-white sm:text-xl">{p.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <WhoWeAre />
</Base>
