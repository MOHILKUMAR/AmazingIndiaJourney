---
// TODO (client): replace with the official disclaimer text, reviewed by the client's legal adviser.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../site.config';
---
<Base title="Disclaimer" description={`Website disclaimer for ${site.name}.`} noindex>
  <PageHero title="Disclaimer" crumbs={[{ label: 'Disclaimer' }]} />
  <section class="container-x py-16">
    <div class="prose-travel max-w-3xl">
      <p><strong>Placeholder.</strong> This page needs the client's official disclaimer before the site goes live.</p>
      <h2>Topics the disclaimer usually covers</h2>
      <ul>
        <li>Accuracy of tour descriptions, photos and prices on this website</li>
        <li>Prices in {site.currency.symbol} per person, subject to availability and change</li>
        <li>Monument opening days and fees (for example, the Taj Mahal is closed on Fridays)</li>
        <li>Third-party services such as hotels, trains and safaris</li>
        <li>Links to other websites</li>
      </ul>
      <p>Questions? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>
