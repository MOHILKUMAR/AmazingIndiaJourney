---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="container-x py-32 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-4 text-5xl text-dark-900">This road doesn’t lead anywhere</h1>
    <p class="mt-4 text-muted">The page you’re looking for has moved or doesn’t exist.</p>
    <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn-primary">Back to home</a><a href="/tours/" class="btn-outline">Browse tours</a></div>
  </section>
</Base>
