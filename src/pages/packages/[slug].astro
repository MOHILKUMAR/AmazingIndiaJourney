---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import TourCard from '../../components/TourCard.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import ReviewSlider from '../../components/ReviewSlider.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatPrice, formatCount } from '../../scripts/format';
import { site, categories, whatsappLink } from '../../site.config';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({ params: { slug: tour.id }, props: { tour } }));
}
interface Props { tour: CollectionEntry<'tours'> }
const { tour } = Astro.props;
const t = tour.data;
const cat = categories.find((c) => c.id === t.category)!;
const others = (await getCollection('tours')).filter((x) => x.id !== tour.id).sort((a, b) => a.data.order - b.data.order);
const sameCat = others.filter((x) => x.data.category === t.category);
const related = [...sameCat, ...others.filter((x) => !sameCat.includes(x))].slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: t.title,
  description: t.summary,
  image: t.image ? new URL(t.image, Astro.site).toString() : undefined,
  itinerary: { '@type': 'ItemList', itemListElement: t.route.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r })) },
  ...(t.priceFrom ? { offers: { '@type': 'Offer', price: t.priceFrom, priceCurrency: site.currency.code, availability: 'https://schema.org/InStock' } } : {}),
  provider: { '@type': 'TravelAgency', name: site.name, telephone: site.phone },
};
const facts = [
  { label: 'Duration', value: t.duration },
  { label: 'Route', value: t.route.join(' → ') },
  { label: 'Pickup', value: t.pickup },
  { label: 'Hotels', value: t.hotelLevel },
  { label: 'Guide', value: t.guide },
  { label: 'Transport', value: t.vehicle },
  { label: 'Meals', value: t.meals },
].filter((f) => f.value);
const tabs = [
  t.itinerary.length > 0 && { id: 'itinerary', label: t.days === 1 ? 'Itinerary' : 'Day by day' },
  (t.inclusions.length > 0 || t.exclusions.length > 0) && { id: 'inclusions', label: 'Inclusions & exclusions' },
  t.importantInfo.length > 0 && { id: 'info', label: 'Important info' },
].filter(Boolean) as { id: string; label: string }[];
const waText = `Hi! I'm interested in: ${t.title}. Please share details and price.`;
---
<Base title={t.title} description={t.summary} image={t.image} jsonLd={jsonLd}>
  <PageHero title={t.title} subtitle={t.summary} image={t.image} eyebrow={`${cat.label} · ${t.duration}`} crumbs={[{ label: 'Tours', href: '/tours/' }, { label: cat.short, href: `/${cat.slug}/` }, { label: t.title }]}>
    {t.reviewCount && <p class="mt-5 inline-flex items-center gap-2 rounded-lg bg-white/10 px-4 py-1.5 text-sm text-white backdrop-blur"><span class="text-accent-400">★★★★★</span> {formatCount(t.reviewCount)} reviews</p>}
  </PageHero>

  <div class="container-x grid gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div class="min-w-0">
      <dl class="grid gap-4 rounded-2xl border border-line bg-white p-6 sm:grid-cols-2 lg:grid-cols-3">
        {facts.map((f) => (<div><dt class="text-xs font-semibold uppercase tracking-wider text-primary-500">{f.label}</dt><dd class="mt-1 text-sm text-ink">{f.value}</dd></div>))}
      </dl>

      <section class="mt-10">
        <h2 class="text-2xl text-dark-900">Tour highlights</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {t.highlights.map((h) => (<li class="flex items-start gap-3 rounded-xl bg-dark-50 p-4 text-sm text-dark-900"><span class="text-primary-500" aria-hidden="true">✦</span>{h}</li>))}
        </ul>
        {t.note && <p class="mt-6 rounded-r-lg border-l-4 border-accent-500 bg-accent-100/60 px-4 py-3 text-sm font-medium text-dark-900">Note: {t.note}</p>}
      </section>

      {tabs.length > 0 && (
        <div class="mt-12" data-tabs>
          <div role="tablist" aria-label="Tour details" class="flex gap-2 overflow-x-auto border-b border-line">
            {tabs.map((tab, i) => (
              <button role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
                class="whitespace-nowrap border-b-2 border-transparent px-4 py-3 text-sm font-semibold text-muted aria-selected:border-primary-500 aria-selected:text-dark-900">{tab.label}</button>
            ))}
          </div>

          {t.itinerary.length > 0 && (
            <div role="tabpanel" id="panel-itinerary" aria-labelledby="tab-itinerary" class="pt-8" hidden={tabs[0].id !== 'itinerary'}>
              <ol class="relative space-y-6 border-l-2 border-line pl-8">
                {t.itinerary.map((d, i) => (
                  <li class="relative">
                    <span class="absolute -left-[41px] top-0.5 flex h-4 w-4 items-center justify-center rounded-lg bg-primary-500 ring-4 ring-cream"></span>
                    <p class="text-xs font-semibold uppercase tracking-wider text-primary-500">{d.time ?? `Day ${d.day ?? i + 1}`}</p>
                    <h3 class="mt-1 font-sans text-base font-semibold text-dark-900">{d.title}</h3>
                    {d.description && <p class="mt-1 text-sm leading-relaxed text-muted">{d.description}</p>}
                  </li>
                ))}
              </ol>
              {t.days > 1 && <p class="mt-6 text-sm text-muted">Need the detailed day-by-day plan? <a href={whatsappLink(waText)} target="_blank" rel="noopener" class="font-semibold text-primary-500 underline">Ask us on WhatsApp</a>. Every itinerary can be customised.</p>}
            </div>
          )}

          {(t.inclusions.length > 0 || t.exclusions.length > 0) && (
            <div role="tabpanel" id="panel-inclusions" aria-labelledby="tab-inclusions" class="pt-8" hidden={tabs[0].id !== 'inclusions'}>
              <div class="grid gap-8 rounded-2xl border border-line bg-white p-6 sm:grid-cols-2">
                {t.inclusions.length > 0 && (
                  <div>
                    <h3 class="font-sans text-sm font-bold uppercase tracking-wider text-dark-900">Inclusions</h3>
                    <ul class="mt-4 space-y-2.5 text-sm">{t.inclusions.map((x) => <li class="flex gap-2"><span class="text-green-600">✓</span>{x}</li>)}</ul>
                  </div>
                )}
                {t.exclusions.length > 0 && (
                  <div>
                    <h3 class="font-sans text-sm font-bold uppercase tracking-wider text-dark-900">Exclusions</h3>
                    <ul class="mt-4 space-y-2.5 text-sm">{t.exclusions.map((x) => <li class="flex gap-2"><span class="text-primary-500">✕</span>{x}</li>)}</ul>
                  </div>
                )}
              </div>
            </div>
          )}

          {t.importantInfo.length > 0 && (
            <div role="tabpanel" id="panel-info" aria-labelledby="tab-info" class="pt-8" hidden={tabs[0].id !== 'info'}>
              <div class="divide-y divide-line rounded-2xl border border-line bg-white">
                {t.importantInfo.map((i) => (
                  <details class="group px-6 py-4">
                    <summary class="flex cursor-pointer list-none justify-between gap-4 font-semibold text-dark-900">{i.title}<span class="text-primary-500 transition group-open:rotate-45">+</span></summary>
                    <p class="mt-2 text-sm text-muted">{i.body}</p>
                  </details>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="h-max lg:sticky lg:top-24">
      <div class="card p-6">
        {t.priceFrom ? (
          <>
            <p class="text-xs text-muted">From</p>
            <p class="flex items-baseline gap-2">
              <span class="font-display text-4xl font-bold text-primary-500" data-tour-price={tour.id}>{formatPrice(t.priceFrom)}</span>
              {t.originalPrice && <s class="text-sm text-muted">{formatPrice(t.originalPrice)}</s>}
              {t.badge && <span class="rounded bg-primary-100 px-2 py-0.5 text-xs font-semibold text-primary-600">{t.badge}</span>}
            </p>
            <p class="text-xs text-muted">{site.currency.perLabel}</p>
          </>
        ) : (
          <>
            <p class="font-display text-3xl font-bold text-primary-500" data-tour-price={tour.id}>Price on request</p>
            <p class="text-xs text-muted">Free quote, customised to your dates and hotels</p>
          </>
        )}
        <a href={whatsappLink(waText)} target="_blank" rel="noopener" class="btn-primary mt-4 w-full">Enquire on WhatsApp</a>
        <hr class="my-5 border-line" />
        <h2 class="text-xl text-dark-900">Send an enquiry</h2>
        <p class="mb-4 mt-1 text-sm text-muted">Reserve with just 15% deposit.</p>
        <EnquiryForm selectedTour={tour.id} compact />
      </div>
    </aside>
  </div>

  <ReviewSlider tour={tour.id} />

  <section class="container-x py-20">
    <h2 class="text-3xl text-dark-900">You may also like</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{related.map((r) => <TourCard tour={r} />)}</div>
  </section>
</Base>
<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (i: number, focus = true) => tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = i !== j;
      if (i === j && focus) t.focus();
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length);
      });
    });
  });
</script>
