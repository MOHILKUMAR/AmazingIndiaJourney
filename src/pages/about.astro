---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import WhyUs from '../components/WhyUs.astro';
import Credentials from '../components/Credentials.astro';
import ReviewSlider from '../components/ReviewSlider.astro';
import MostReviewed from '../components/MostReviewed.astro';
import CTABanner from '../components/CTABanner.astro';
import { site } from '../site.config';
---
<Base title="About Us" description={`${site.name}, a unit of ${site.parent}, an inbound tour company in Agra, trusted since ${site.established}.`}>
  <PageHero title="About us" subtitle="Your trusted trip companion in North India." image="/images/amber-fort.webp" crumbs={[{ label: 'About us' }]} />
  <section class="container-x grid items-center gap-12 py-20 lg:grid-cols-2">
    <div class="prose-travel">
      <p class="eyebrow">Who we are · Trusted since {site.established}</p>
      <h2 class="!mt-3 text-3xl sm:text-4xl">Your trusted trip companion in North India</h2>
      <p>{site.name}, a unit of <strong>{site.parent}</strong>, is a renowned inbound tour company specialising in same-day and multi-day tours of the Golden Triangle (Delhi, Agra, Jaipur) and other destinations across North India.</p>
      <p>For over 18 years we have guided more than <strong>50,000 travellers</strong> through India's cultural heartlands. Our young, energetic team is led by professionals with over two decades of combined field experience, and every itinerary is well researched and planned around you.</p>
      <blockquote class="!not-italic font-display text-xl !text-primary-500">“{site.motto}”</blockquote>
    </div>
    <img src="/images/about.webp" alt="Traveller at the Taj Mahal framed by an arch" width="564" height="563" loading="lazy" class="aspect-[4/3] w-full rounded-2xl object-cover" />
  </section>
  <Credentials />
  <WhyUs />
  <section class="container-x grid gap-8 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <div class="grid grid-cols-2 gap-4">
      <div class="col-span-2 rounded-2xl bg-dark-900 p-6 text-center text-white">
        <p class="font-display text-6xl font-bold text-accent-400">{site.rating.score}</p>
        <p class="text-sm">out of 5 · <span class="text-accent-400">★★★★★</span></p>
        <p class="mt-1 text-xs text-dark-100/80">Average guest rating on Google</p>
      </div>
      <div class="rounded-2xl border border-line bg-white p-5"><p class="font-display text-2xl font-bold text-primary-500">50,000+</p><p class="text-xs text-muted">travellers hosted since {site.established}</p></div>
      <div class="rounded-2xl border border-line bg-white p-5"><p class="font-display text-2xl font-bold text-primary-500">8×</p><p class="text-xs text-muted">TripAdvisor Certificate of Excellence</p></div>
    </div>
    <MostReviewed />
  </section>
  <ReviewSlider />
  <CTABanner />
</Base>
